{
  "name": "daxuan-tte-router",
  "version": "0.4.0",
  "owner": "20260907_Clinical_Database",
  "updated_at": "2026-10-24",
  "status": "public-development",
  "maturity_tier": "library",
  "lifecycle_stage": "evidence-gated-research-pipeline",
  "context_budget_tier": "production",
  "upstream_inspiration": "TTE_CC by Jacob Jameson",
  "upstream_sync": {
    "source": "https://github.com/jacobjameson/TTE_CC",
    "relationship": "routes installed specialist skills; does not copy their implementation"
  },
  "intent": {
    "job_to_be_done": "Turn a clinical research question into an evidence-aware estimand, data-support gate, and minimal target-trial-emulation specialist route.",
    "target_users": [
      "clinical researchers in this project",
      "TTE analysts"
    ],
    "inputs": [
      "clinical research question or topic",
      "literature corpus or search request",
      "target-trial protocol or draft",
      "available database and data semantics",
      "current analysis stage"
    ],
    "outputs": [
      "intent classification",
      "selected TTE specialists",
      "supporting research skills",
      "evidence tasks and sources",
      "estimand/design card",
      "stage handoff",
      "protocol/data artifact",
      "data gaps and validity threats",
      "run status",
      "resumable research state",
      "phase handoff artifacts",
      "pilot decision and result feedback"
    ],
    "exclusions": [
      "unverified novelty claims",
      "new estimator invention",
      "unrequested cohort mutation",
      "clinical threshold selection from outcomes",
      "journal acceptance claims",
      "publication"
    ],
    "qiaomu_defaults": {
      "language": "zh-CN",
      "evidence_boundary": "claim only what was read or executed",
      "primary_principle": "clinical question before method",
      "routing_principle": "route the smallest useful set; clinical context overrides keyword suggestions"
    }
  },
  "release_gates": {
    "local": [
      "portable-path check",
      "skill resolution check",
      "route unit tests",
      "pipeline behavior tests",
      "trigger_eval when qiaomu-meta-skill is installed"
    ],
    "publish": [
      "explicit user request",
      "PR workflow",
      "release and clean-install evidence"
    ]
  }
}
